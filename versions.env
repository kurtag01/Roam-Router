# Versions built into every Roam release. Bump ROAM_VERSION for each release;
# .github/workflows/watch-openwrt.yml proposes OPENWRT_VERSION bumps automatically.
ROAM_VERSION=1.0.0
OPENWRT_VERSION=25.12.6
# Raspberry Pi OS Lite (64-bit) used for the ready-to-flash host image
PIOS_RELEASE=2026-10-06
PIOS_FILE=2026-10-06-raspios-trixie-arm64-lite.img.xz
# UniFi Teleport client (experimental VPN option): upstream commit + Roam's patch in
# src/teleport/, built with this Go toolchain (checksum from go.dev/dl).
TELEPORT_CLIENT_REPO=https://github.com/sinnet3000/teleport-client
TELEPORT_CLIENT_COMMIT=caf15681bec5ae539bfb3f89c83b935d51726129
GO_VERSION=1.26.11
GO_SHA256=9849f4e04ee35303714e34fbc3ac8ab44ea3e448a95aa182f91e3b9b79c710ec
