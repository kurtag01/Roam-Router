diff --git a/roamtun_linux.go b/roamtun_linux.go
new file mode 100644
index 0000000..a8c995c
--- /dev/null
+++ b/roamtun_linux.go
@@ -0,0 +1,372 @@
+//go:build linux
+
+package main
+
+// Roam router additions (OpenWrt):
+//
+//   --tun <name>     carry the tunnel on a kernel TUN interface instead of the userspace
+//                    netstack + SOCKS5 proxy, so the router can route its LAN through it.
+//                    The interface lives as long as the process: renegotiations reuse it,
+//                    so traffic waits in the tunnel instead of leaking out the uplink.
+//   --fwmark <n>     mark the client's own sockets (Teleport API, STUN, WireGuard UDP),
+//                    so policy routing sends them out the uplink, not into the tunnel.
+//   --dns <ip>       resolve the client's own hostnames with this server (marked socket),
+//                    independent of the router's DNS (which points into the tunnel).
+//   --hook <path>    run "<path> <event>" with TELEPORT_* variables: up, connected,
+//                    unhealthy, reconnecting, paired.
+//   --status <path>  JSON status file (state, console name, endpoint, last error).
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+var (
+	roamFwmark      int
+	roamHookPath    string
+	roamStatusPath  string
+	roamKernelTun   *roamTun
+	roamConsoleName atomic.Value // string
+	roamTunnelEnv   atomic.Value // []string: TELEPORT_* of the current tunnel
+)
+
+func roamFlags(tunName, fwmark, dns, hook, status *string) {
+	if *fwmark != "" {
+		v, err := strconv.ParseInt(*fwmark, 0, 32)
+		if err != nil || v <= 0 {
+			fmt.Fprintln(os.Stderr, "error: --fwmark must be a positive number (e.g. 0x5450)")
+			os.Exit(2)
+		}
+		roamFwmark = int(v)
+		d := &net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second, Control: roamMarkControl}
+		t := http.DefaultTransport.(*http.Transport).Clone()
+		t.DialContext = d.DialContext
+		http.DefaultTransport = t
+	}
+	if *dns != "" {
+		server := *dns
+		if _, _, err := net.SplitHostPort(server); err != nil {
+			server = net.JoinHostPort(server, "53")
+		}
+		net.DefaultResolver = &net.Resolver{PreferGo: true, Dial: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			d := net.Dialer{Timeout: 5 * time.Second, Control: roamMarkControl}
+			return d.DialContext(ctx, network, server)
+		}}
+	}
+	roamHookPath, roamStatusPath = *hook, *status
+	roamConsoleName.Store("")
+	roamTunnelEnv.Store([]string(nil))
+	if *tunName != "" {
+		t, err := openRoamTun(*tunName, baseTunnelMTU)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "error: cannot create TUN interface %q: %v\n", *tunName, err)
+			os.Exit(1)
+		}
+		roamKernelTun = t
+	}
+}
+
+func roamClose() {
+	if roamKernelTun != nil {
+		_ = roamKernelTun.dev.Close()
+	}
+}
+
+// roamMarkControl sets SO_MARK on a socket before it binds/connects.
+func roamMarkControl(_, _ string, c syscall.RawConn) error {
+	if roamFwmark == 0 {
+		return nil
+	}
+	var serr error
+	if err := c.Control(func(fd uintptr) {
+		serr = syscall.SetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_MARK, roamFwmark)
+	}); err != nil {
+		return err
+	}
+	return serr
+}
+
+func roamListenUDP(network string, addr *net.UDPAddr) (*net.UDPConn, error) {
+	lc := net.ListenConfig{Control: roamMarkControl}
+	pc, err := lc.ListenPacket(context.Background(), network, addr.String())
+	if err != nil {
+		return nil, err
+	}
+	return pc.(*net.UDPConn), nil
+}
+
+func roamDialUDP(endpoint *net.UDPAddr) (*net.UDPConn, error) {
+	d := net.Dialer{Control: roamMarkControl}
+	c, err := d.Dial("udp", endpoint.String())
+	if err != nil {
+		return nil, err
+	}
+	return c.(*net.UDPConn), nil
+}
+
+func roamRouteGetArgs(ip string) []string {
+	if roamFwmark != 0 {
+		return []string{"route", "get", ip, "mark", strconv.Itoa(roamFwmark)}
+	}
+	return []string{"route", "get", ip}
+}
+
+func roamSkipInterface(name string) bool {
+	if roamKernelTun != nil && name == roamKernelTun.name {
+		return true
+	}
+	return false
+}
+
+// ---- hook and status ----
+
+type roamStatus struct {
+	State     string `json:"state"`
+	Console   string `json:"console,omitempty"`
+	Endpoint  string `json:"endpoint,omitempty"`
+	Mode      string `json:"mode,omitempty"`
+	ClientIP  string `json:"client_ip,omitempty"`
+	Error     string `json:"error,omitempty"`
+	Updated   int64  `json:"updated"`
+	Connected int64  `json:"connected,omitempty"`
+}
+
+var (
+	roamStatusMu sync.Mutex
+	roamCur      roamStatus
+)
+
+func roamSetStatus(update func(s *roamStatus)) {
+	roamStatusMu.Lock()
+	defer roamStatusMu.Unlock()
+	update(&roamCur)
+	roamCur.Console, _ = roamConsoleName.Load().(string)
+	roamCur.Updated = time.Now().Unix()
+	if roamStatusPath == "" {
+		return
+	}
+	data, err := json.Marshal(roamCur)
+	if err != nil {
+		return
+	}
+	tmp := roamStatusPath + ".tmp"
+	if os.WriteFile(tmp, append(data, '\n'), 0o644) == nil {
+		_ = os.Rename(tmp, roamStatusPath)
+	}
+}
+
+func roamState(state, errText string) {
+	roamSetStatus(func(s *roamStatus) {
+		s.State, s.Error = state, errText
+		if state == "connected" {
+			s.Connected = time.Now().Unix()
+		} else if state != "unhealthy" {
+			s.Connected = 0
+		}
+	})
+}
+
+func roamHook(event string) {
+	if roamHookPath == "" {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, roamHookPath, event)
+	env := append(os.Environ(), "TELEPORT_CONSOLE="+oneLine(roamConsoleName.Load().(string)))
+	if t := roamTunnelEnv.Load().([]string); t != nil {
+		env = append(env, t...)
+	}
+	cmd.Env = env
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		appLog.Warn("hook failed", "event", event, "error", err, "output", strings.TrimSpace(string(out)))
+	}
+}
+
+func oneLine(s string) string {
+	return strings.Map(func(r rune) rune {
+		if r < 0x20 || r == 0x7f {
+			return ' '
+		}
+		return r
+	}, s)
+}
+
+// roamTunnelUp records the tunnel's addresses and runs the "up" hook, which configures
+// the interface, routes and rules before traffic starts.
+func roamTunnelUp(p tunnelParams, endpoint, mode string, mtu int) {
+	info := p.connResp.ServerInfo
+	env := []string{
+		"TELEPORT_IFNAME=" + roamKernelTun.name,
+		"TELEPORT_IP=" + p.connResp.ClientIP,
+		// tunnel_addr/tunnel_mask: the router's own IPv6 address inside the tunnel
+		// (the console's UDP echo server is on that prefix).
+		"TELEPORT_IP6=" + info.TunnelAddr,
+		"TELEPORT_IP6_MASK=" + strconv.Itoa(info.TunnelMask),
+		"TELEPORT_DNS=" + strings.Join(p.connResp.DNSAddrs, " "),
+		"TELEPORT_MTU=" + strconv.Itoa(mtu),
+		"TELEPORT_ENDPOINT=" + endpoint,
+		"TELEPORT_MODE=" + mode,
+	}
+	roamTunnelEnv.Store(env)
+	roamSetStatus(func(s *roamStatus) {
+		s.Endpoint, s.Mode, s.ClientIP = endpoint, mode, p.connResp.ClientIP
+	})
+	roamState("handshake", "")
+	roamHook("up")
+}
+
+// ---- kernel TUN that outlives individual WireGuard devices ----
+
+type roamTun struct {
+	dev  tun.Device
+	name string
+	mu   sync.Mutex
+	view *roamTunView
+}
+
+func openRoamTun(name string, mtu int) (*roamTun, error) {
+	dev, err := tun.CreateTUN(name, mtu)
+	if err != nil {
+		return nil, err
+	}
+	real, err := dev.Name()
+	if err != nil {
+		_ = dev.Close()
+		return nil, err
+	}
+	t := &roamTun{dev: dev, name: real}
+	// The kernel device's own events are not needed: wireguard-go is brought up
+	// explicitly, and MTU changes are announced by SetMTU.
+	go func() {
+		for range dev.Events() {
+		}
+	}()
+	return t, nil
+}
+
+// newView hands one WireGuard device a handle on the interface. Closing the view
+// detaches that device; the interface itself stays.
+func (t *roamTun) newView() *roamTunView {
+	_ = t.dev.File().SetReadDeadline(time.Time{})
+	v := &roamTunView{t: t, events: make(chan tun.Event, 4)}
+	t.mu.Lock()
+	t.view = v
+	t.mu.Unlock()
+	return v
+}
+
+func (t *roamTun) SetMTU(mtu int) error {
+	if out, err := exec.Command("ip", "link", "set", "dev", t.name, "mtu", strconv.Itoa(mtu)).CombinedOutput(); err != nil {
+		return fmt.Errorf("ip link set mtu %d: %v: %s", mtu, err, strings.TrimSpace(string(out)))
+	}
+	t.mu.Lock()
+	v := t.view
+	t.mu.Unlock()
+	if v != nil {
+		v.notify(tun.EventMTUUpdate)
+	}
+	return nil
+}
+
+type roamTunView struct {
+	t      *roamTun
+	closed atomic.Bool
+	mu     sync.Mutex
+	events chan tun.Event
+}
+
+func (v *roamTunView) notify(e tun.Event) {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if v.closed.Load() {
+		return
+	}
+	select {
+	case v.events <- e:
+	default:
+	}
+}
+
+func (v *roamTunView) File() *os.File { return v.t.dev.File() }
+
+func (v *roamTunView) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	if v.closed.Load() {
+		return 0, os.ErrClosed
+	}
+	n, err := v.t.dev.Read(bufs, sizes, offset)
+	if v.closed.Load() || errors.Is(err, os.ErrDeadlineExceeded) {
+		return 0, os.ErrClosed // read after detach (at most one batch is lost)
+	}
+	return n, err
+}
+
+func (v *roamTunView) Write(bufs [][]byte, offset int) (int, error) {
+	if v.closed.Load() {
+		return 0, os.ErrClosed
+	}
+	return v.t.dev.Write(bufs, offset)
+}
+
+func (v *roamTunView) MTU() (int, error)        { return v.t.dev.MTU() }
+func (v *roamTunView) Name() (string, error)    { return v.t.name, nil }
+func (v *roamTunView) Events() <-chan tun.Event { return v.events }
+func (v *roamTunView) BatchSize() int           { return v.t.dev.BatchSize() }
+
+func (v *roamTunView) Close() error {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if v.closed.Swap(true) {
+		return nil
+	}
+	// WireGuard's device.Close waits for its reader, which sits in read() on the
+	// kernel TUN: wake it (the TUN fd is non-blocking, so deadlines work).
+	_ = v.t.dev.File().SetReadDeadline(time.Now())
+	close(v.events)
+	return nil
+}
+
+// ---- UDP echo (tunnel health) over the kernel interface ----
+
+type kernelEcho struct {
+	t      *roamTun
+	local4 net.IP // client_ip
+	local6 net.IP // tunnel_addr
+}
+
+func (k kernelEcho) DialUDP(raddr *net.UDPAddr) (net.Conn, error) {
+	d := net.Dialer{Control: func(_, _ string, c syscall.RawConn) error {
+		var serr error
+		if err := c.Control(func(fd uintptr) {
+			serr = syscall.BindToDevice(int(fd), k.t.name)
+		}); err != nil {
+			return err
+		}
+		return serr
+	}}
+	local := k.local4
+	if raddr.IP.To4() == nil {
+		local = k.local6
+	}
+	if local != nil {
+		d.LocalAddr = &net.UDPAddr{IP: local}
+	}
+	return d.Dial("udp", raddr.String())
+}
+
+func (k kernelEcho) SetMTU(mtu int) error { return k.t.SetMTU(mtu) }
