# Roam router: OpenWrt as a system container (generated by install.sh)
lxc.uts.name = Roam-Pi
lxc.rootfs.path = dir:/var/lib/lxc/roam/rootfs
lxc.init.cmd = /sbin/init
# procd: SIGUSR2 = power off, SIGTERM = reboot
lxc.signal.halt = SIGUSR2
lxc.signal.reboot = SIGTERM

# The router container is trusted: privileged, but it may not load kernel modules
# (they come from the host) or change the clock (the host keeps time).
lxc.apparmor.profile = unconfined
lxc.cap.drop = sys_module sys_time mac_admin mac_override
lxc.mount.auto = proc:rw sys:rw cgroup:mixed
lxc.autodev = 1
lxc.pty.max = 16
lxc.tty.max = 0

# Devices: the router is trusted (an allow-list here would also block /dev/null etc.).
# tun (VPNs) and ppp (PPPoE) are bound in below.
lxc.cgroup2.devices.allow = a
# ...except the host's hardware watchdog: OpenWrt's procd would grab it, and the board
# would then hard-reset ~30 s after the router stops. (Pi OS's systemd feeds it itself.)
lxc.cgroup2.devices.deny = c 10:130 rwm
lxc.mount.entry = /dev/net dev/net none bind,create=dir,optional 0 0
lxc.mount.entry = /dev/ppp dev/ppp none bind,create=file,optional 0 0

# The Pi's Ethernet port belongs to the router.
lxc.net.0.type = phys
lxc.net.0.link = @ETH@
lxc.net.0.name = eth0
lxc.net.0.flags = up

# Link to the host OS: "lanhost" joins the router's LAN bridge, "rhost" (host side)
# gets 192.168.8.2.
lxc.net.1.type = veth
lxc.net.1.name = lanhost
lxc.net.1.veth.pair = rhost
lxc.net.1.hwaddr = 02:52:4f:41:4d:01
lxc.net.1.flags = up

# Hand all Wi-Fi radios to the router before it boots.
lxc.hook.start-host = /usr/local/lib/roam/lxc-start-host
